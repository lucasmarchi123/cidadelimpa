# Modelo do arquivo .env
# Copie este arquivo com o nome .env e preencha os valores.
# O .env NUNCA vai para o GitHub; este modelo vai, sem nenhum segredo.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True no seu computador. False quando o site for publicado.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Opcional: chave do Google Maps, quando for usar o mapa real
GOOGLE_MAPS_API_KEY=
